# 00_Cerebrum vault — tracked: Wiki bundles, Outputs, docs, scripts, skills.
# Untracked, by decision:

# The archive layers. Read-only bulk exports; they never change and do not
# belong in a git history. Rename this to match your own archive folder if it
# is not called OneNote/, and declare it as archive_layer in the knowledge
# base's assertions.yaml so coverage.py can find it.
OneNote/

# The Raw layers, analog to the archive: git holds the distilled knowledge,
# the disk holds the sources.
# The registry stays tracked so the repo still records what Raw holds even
# though it no longer holds it.
**/Raw/*
!**/Raw/_INGESTED.md

# Owner testimony. Same class as Raw: source material, not distilled
# knowledge. It sits at the vault root rather than in a knowledge base because
# a transcript may be cited from several bundles.
_testimony/

# Retirement bins. Files here await manual deletion (the session VM cannot
# delete); they are not knowledge and must not reach GitHub. Git history is
# the real archive of retired concepts once this repo exists.
_to_delete/

# App state, not knowledge.
.obsidian/
.cogito-folder.json
.DS_Store

# Python bytecode. Generated by _scripts/ on every run; the .py files are the
# record, the .pyc files are noise that churns on every Python version bump.
__pycache__/
*.pyc

# Derived output of _scripts/visualize.py; regenerate rather than track.
okf-viewer.html

# Derived cache of _scripts/namescan.py; regenerate rather than track.
_scripts/.namescan-cache.json

# Packed batches and inventories: derived working files of a compile run,
# regenerated by _scripts/prepare-batch.py. The extraction files themselves
# ARE tracked — they are what an agent handed back and what merge-appends.py
# replays — but the packs are just the archive re-arranged.
**/_extractions/_packed-*.txt
**/_extractions/_INVENTORY.md
**/.coverage-state.json

# FUSE leftovers: created when a file is renamed while still open.
# One can reach a commit from merge-appends.py archiving a handback.
.fuse_hidden*

# Archive snapshots. Fingerprint and inventory files carry per-page data
# derived from the gitignored archive layers, so tracking them reopens the
# boundary the archive is excluded for. One such preview column was found
# carrying a certificate passphrase in clear.
_snapshots/

# Claude Code project state. `.claude/skills/` is tracked — it is how a local
# session reaches the three skills — but everything the harness writes for
# itself is machine-local and must not travel.
.claude/*
!.claude/skills
.claude/settings.local.json

# Node dependencies for _scripts/viewer-check.js. The lockfile and manifest
# are tracked so the viewer check's dependency is recorded; node_modules/ is
# not. Run `npm install` before the first viewer check.
node_modules/
